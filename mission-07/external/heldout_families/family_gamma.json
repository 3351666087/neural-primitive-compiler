{
 "name": "gamma",
 "author": "held-out custodian",
 "interior_walls": 6,
 "phase": {"every": 150, "k": 2},
 "kinds": {
  "k1": {"solid": true,
         "latent": {"tune": {"domain": [0, 1], "init": 0},
                    "ready": {"domain": [0, 1], "init": 0},
                    "ring": {"domain": [0, 1], "init": 0}}},
  "k2": {"visibility": "revealed",
         "consumable": {"need": "food", "amount": 30, "cooldown": 20}},
  "k3": {"pickable": true,
         "consumable": {"need": "water", "amount": 40, "vanish": true}},
  "k4": {"solid": true,
         "consumable": {"need": "water", "amount": 8, "cooldown": 100}},
  "k5": {"solid": true, "visible_features": ["f"]}
 },
 "placement": {"k1": 3, "k2": 6, "k4": 1, "k5": 1},
 "placement_constraints": [{"type": "near", "kind": "k2", "to": "k1", "dist": 2}],
 "rules": [
  {"on": "tick", "kind": "k1",
   "guard": ["and", ["==", ["latent", "self", "ready"], 0], ["chance", 0.5]],
   "effects": [["set", "self", "tune", 1], ["set", "self", "ready", 1]]},
  {"on": "tick", "kind": "k1",
   "guard": ["==", ["latent", "self", "ready"], 0],
   "effects": [["set", "self", "ready", 1]]},
  {"on": "tick", "kind": "k1",
   "guard": ["and", ["==", ["latent", "self", "ring"], 1], [">=", ["since", "rang"], 18]],
   "effects": [["set", "self", "ring", 0]]},
  {"on": "poke", "kind": "k1",
   "guard": ["and", ["==", ["latent", "self", "tune"], ["phase"]],
                    ["exists_near", "k1", 10, ["==", ["latent", "it", "ring"], 1]]],
   "effects": [["spawn", "k3", "self", 1], ["log", "chord"]],
   "exclusive": false},
  {"on": "poke", "kind": "k1",
   "guard": ["==", ["latent", "self", "tune"], ["phase"]],
   "effects": [["reveal", "k2", 2, 25], ["set", "self", "ring", 1], ["mark", "rang"], ["log", "chime"]]},
  {"on": "poke", "kind": "k5",
   "guard": ["==", ["visible", "self", "f"], 0],
   "effects": [["set_visible", "self", "f", 1]]},
  {"on": "poke", "kind": "k5",
   "effects": [["set_visible", "self", "f", 0]]}
 ]
}
